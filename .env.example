# ForgeRouter environment

APP_ENV=local
APP_NAME=forgerouter
APP_HOST=127.0.0.1
APP_PORT=2100

# PostgreSQL
# Only used by docker-compose.standalone.yml's bundled Postgres container —
# POSTGRES_USER/PASSWORD is its admin role (schema owner, runs migrations);
# PROXYROUTER_PASSWORD is the restricted app role (proxyrouter_user, matching
# the GRANTs in db/*.sql) ForgeRouter actually connects as. Both DATABASE_URL
# and PROXYROUTER_PASSWORD are generated/overridden automatically by
# scripts/install_standalone.sh — see INSTALL.md. If you're pointing at your
# own externally-managed Postgres instead (docker-compose.yml), just set
# DATABASE_URL directly and ignore the rest of this block.
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=forgerouter
POSTGRES_USER=proxyrouter_user
POSTGRES_PASSWORD=change_me
PROXYROUTER_PASSWORD=
DATABASE_URL=postgresql://proxyrouter_user:change_me@localhost:5434/forgerouter

# Router storage schema/table prefix
AI_ROUTER_DB_SCHEMA=ai_router
AI_ROUTER_TABLE_PREFIX=ai_router_

# Safety defaults
ENABLE_PAID_FALLBACK=false
REDACT_SECRETS=true
LOG_PROMPTS=false

# Per-provider API keys — only required for the providers you enable
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=

# Optional: shared secret for trusted SSO from a companion app (sent server-to-server)
FORGEHUB_SSO_SECRET=

# Login screen reCAPTCHA v2 (see CLAUDE.md). Empty = feature off (fail-open,
# login unaffected). Create the key pair for forgerouter.darckware.net at
# https://www.google.com/recaptcha/admin/create (type: reCAPTCHA v2 "I'm not
# a robot" checkbox). The site key (public) also needs to be set as
# VITE_RECAPTCHA_SITE_KEY in frontend/.env before `npm run build` -- Vite
# only reads env files from the frontend/ directory itself, not this one.
RECAPTCHA_SECRET_KEY=
